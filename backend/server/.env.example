PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/coderecall?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Create an OAuth 2.0 Web client in Google Cloud Console and add your local/production origins.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=CodeRecall <no-reply@example.com>
